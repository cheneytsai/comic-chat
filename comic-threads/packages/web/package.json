{
  "name": "@comic-threads/web",
  "version": "0.1.0",
  "private": true,
  "description": "Comic Threads web shell: paste a GitHub issue/PR URL, watch it become a Comic Chat strip.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@comic-threads/core": "0.1.0",
    "@comic-threads/github-source": "0.1.0",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
