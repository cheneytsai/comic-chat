node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/

# The repo root .gitignore has a NuGet-era "**/[Pp]ackages/*" rule (for the
# original VC++ build's packages/ folders) that would otherwise also match
# and silently swallow this monorepo's packages/ workspace directory.
!/packages/
!/packages/**

# The negation above re-includes everything under packages/, which would
# otherwise re-surface node_modules/dist/etc. that the rules above meant to
# exclude. Re-apply those exclusions scoped to packages/.
packages/**/node_modules/
packages/**/dist/
packages/**/*.tsbuildinfo
packages/**/coverage/
